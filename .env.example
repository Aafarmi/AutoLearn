# 复制为 .env 后按需修改。.env 已进 .gitignore，绝不提交。
#
# 密钥优先级：环境变量 > OS 凭据管理器(keyring) > 不提供
# 本项目密钥由用户在软件内 UI 表单自行添加，正常情况下**无需**在此填写。

# 运行配置文件路径（默认 state/run_config.json）
# AUTOLEARN_RUN_CONFIG=state/run_config.json

# 运行配置覆盖示例（嵌套用双下划线）
# 注意：v0.2.0 起没有「通道优先级 / 通道模式」这两个字段了 —— 页面只由模型读，
# 原先的 AUTOLEARN_PROBE_ORDER / AUTOLEARN_PROBE_MODE 会被静默忽略。
# AUTOLEARN_DRY_RUN=true
# AUTOLEARN_SAMPLE_N=5
# AUTOLEARN_GUARDS__SINGLE_TOP1_MIN=0.85

# 靶场服务端口
AUTOLEARN_MOCK_PORT=8899
# 跨域 iframe 专用端口：必须与主端口不同源，否则测不出真实的跨域形态
AUTOLEARN_MOCK_FRAME_PORT=8900
