{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autolearn:adapter:chaoxing:questions:1.0",
  "title": "Chaoxing questions package",
  "description": "Question content and answer-slot shape extracted from a Chaoxing work page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_id", "adapter_version", "schema_version", "run_id", "questions"],
  "properties": {
    "site_id": { "const": "chaoxing" },
    "adapter_version": { "const": "0.1.0" },
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "asset_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "description": "Run-relative path using forward slashes, such as assets/image-001.png."
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "asset_paths"],
      "properties": {
        "text": { "type": "string" },
        "html": {
          "type": "string",
          "description": "Sanitized presentation markup; image sources must refer to local assets."
        },
        "asset_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/asset_path" }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label", "content"],
      "properties": {
        "option_id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "content": { "$ref": "#/$defs/content" }
      }
    },
    "answer_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "ordinal", "input_kind"],
      "properties": {
        "slot_id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "input_kind": { "enum": ["text_input", "rich_text_editor"] }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "number",
        "question_type",
        "source_type",
        "stem",
        "options",
        "answer_slots"
      ],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "number": { "type": "integer", "minimum": 1 },
        "question_type": { "enum": ["single_choice", "fill_blank", "short_answer"] },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "description": "Original Chaoxing typename, for example 单选题, 填空题, or 简答题."
        },
        "stem": { "$ref": "#/$defs/content" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "answer_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/answer_slot" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "question_type": { "const": "single_choice" } },
            "required": ["question_type"]
          },
          "then": {
            "properties": {
              "options": { "minItems": 2 },
              "answer_slots": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "question_type": { "const": "fill_blank" } },
            "required": ["question_type"]
          },
          "then": {
            "properties": {
              "options": { "maxItems": 0 },
              "answer_slots": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "question_type": { "const": "short_answer" } },
            "required": ["question_type"]
          },
          "then": {
            "properties": {
              "options": { "maxItems": 0 },
              "answer_slots": { "minItems": 1, "maxItems": 1 }
            }
          }
        }
      ]
    }
  }
}
