{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autolearn:adapter:cjyuketang:execution-result:1.0",
  "title": "Changjiang Yuketang execution result",
  "description": "Per-question interaction outcome and website evidence returned by Rain Classroom after the WebUI confirmation flow. A WebUI confirmation alone is not success evidence; one-time confirmation IDs are never written to this result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_id",
    "adapter_version",
    "schema_version",
    "run_id",
    "started_at",
    "completed_at",
    "items"
  ],
  "properties": {
    "site_id": { "const": "cjyuketang" },
    "adapter_version": { "const": "0.1.0" },
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "confirmation": {
      "type": "object",
      "description": "Website-side evidence observed after the WebUI-authorized submit action.",
      "additionalProperties": false,
      "required": ["method", "observed_at"],
      "properties": {
        "method": {
          "description": "The page evidence that supports a confirmed result; this does not represent the WebUI confirmation itself.",
          "enum": ["success_message", "result_page", "answer_echo", "other"]
        },
        "observed_at": { "type": "string", "format": "date-time" },
        "detail": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "status", "attempted"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "status": {
          "description": "confirmed requires page success evidence after WebUI authorization; an ambiguous post-submit result is unconfirmed and must not be retried automatically.",
          "enum": ["confirmed", "failed", "unconfirmed", "skipped", "filled_unsubmitted"]
        },
        "attempted": { "type": "boolean" },
        "confirmation": { "$ref": "#/$defs/confirmation" },
        "error": { "$ref": "#/$defs/error" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "confirmed" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "attempted": { "const": true } },
            "required": ["confirmation"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "attempted": { "const": true } },
            "required": ["error"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "unconfirmed" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "attempted": { "const": true } },
            "required": ["reason"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "skipped" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "attempted": { "const": false } },
            "required": ["reason"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "filled_unsubmitted" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "attempted": { "const": false } },
            "required": ["reason"]
          }
        }
      ]
    }
  }
}
