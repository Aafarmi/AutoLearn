{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autolearn:adapter:cjyuketang:interaction:1.0",
  "title": "Changjiang Yuketang interaction metadata",
  "description": "Page selectors and current control state observed during crawling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_id", "adapter_version", "schema_version", "run_id", "page", "question_controls"],
  "properties": {
    "site_id": { "const": "cjyuketang" },
    "adapter_version": { "const": "0.1.0" },
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "submit_selector": {
          "$ref": "#/$defs/selector",
          "description": "Optional unique submit control selector verified on the live page."
        }
      }
    },
    "question_controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question_controls" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "description": "A unique CSS selector; never executable JavaScript."
    },
    "choice_option_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "selector"],
      "properties": {
        "option_id": { "$ref": "#/$defs/id" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "answer_slot_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "selector", "control_type", "current_value"],
      "properties": {
        "slot_id": { "$ref": "#/$defs/id" },
        "selector": { "$ref": "#/$defs/selector" },
        "control_type": { "enum": ["text_input", "rich_text_editor"] },
        "current_value": { "type": "string" },
        "frame_selector": {
          "$ref": "#/$defs/selector",
          "description": "Selector of the same-origin iframe that hosts the editable body."
        }
      }
    },
    "question_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_type",
        "question_selector",
        "choice_options",
        "answer_slots"
      ],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "question_type": {
          "enum": ["single_choice", "multiple_choice", "fill_blank", "short_answer"]
        },
        "question_selector": { "$ref": "#/$defs/selector" },
        "choice_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice_option_control" }
        },
        "selected_option_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "selected_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "answer_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/answer_slot_control" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "question_type": { "const": "single_choice" } },
            "required": ["question_type"]
          },
          "then": { "required": ["selected_option_id"] }
        },
        {
          "if": {
            "properties": { "question_type": { "const": "multiple_choice" } },
            "required": ["question_type"]
          },
          "then": { "required": ["selected_option_ids"] }
        }
      ]
    }
  }
}
