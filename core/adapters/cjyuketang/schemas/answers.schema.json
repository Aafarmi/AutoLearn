{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autolearn:adapter:cjyuketang:answers:1.0",
  "title": "Changjiang Yuketang answers package",
  "description": "Answer values keyed by question and answer-slot IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_id", "adapter_version", "schema_version", "run_id", "answers"],
  "properties": {
    "site_id": { "const": "cjyuketang" },
    "adapter_version": { "const": "0.1.0" },
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/single_choice_answer" },
          { "$ref": "#/$defs/multiple_choice_answer" },
          { "$ref": "#/$defs/fill_blank_answer" },
          { "$ref": "#/$defs/short_answer" }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "single_choice_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "answer_type", "value"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "answer_type": { "const": "single_choice" },
        "value": { "$ref": "#/$defs/id" }
      }
    },
    "multiple_choice_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "answer_type", "values"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "answer_type": { "const": "multiple_choice" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "fill_blank_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "value"],
      "properties": {
        "slot_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "fill_blank_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "answer_type", "values"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "answer_type": { "const": "fill_blank" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fill_blank_value" }
        }
      }
    },
    "short_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "answer_type", "value"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "answer_type": { "const": "short_answer" },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
